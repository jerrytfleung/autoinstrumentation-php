{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": ["dependencies"],
  "enabledManagers": ["regex", "npm", "pip_requirements", "gomod", "github-actions", "dockerfile"],
  "packageRules": [
    {
      "matchManagers": ["regex"],
      "matchFileNames": ["version.txt"],
      "commitMessageTopic": "OpenTelemetry PHP agent version"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackagePatterns": ["^docker/"],
      "groupName": "docker GitHub Actions"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["docker-bake.hcl", "Dockerfile", "Dockerfile.final"],
      "groupName": "production base images"
    }
  ]
}